---
import type { ProjectsView } from '@vvitrine/sections';
type Props = ProjectsView & { sectionId: string };
const { title, items, moreLabel, sectionId } = Astro.props;
---

<section id={sectionId} aria-labelledby={`${sectionId}-title`}>
  <h2 id={`${sectionId}-title`}>{title}</h2>
  <ul class="grid">
    {items.map((p) => (
      <li class={`card${p.featured ? ' featured' : ''}`}>
        {p.image && <img src={p.image.src} alt={p.image.alt} loading="lazy" decoding="async" />}
        <h3>
          <a href={p.href}>{p.name}</a>
        </h3>
        {p.description && <p>{p.description}</p>}
        {p.keywords.length > 0 && (
          <ul class="tags">
            {p.keywords.map((k) => (
              <li>{k}</li>
            ))}
          </ul>
        )}
        <a class="more" href={p.href} aria-label={`${moreLabel}: ${p.name}`}>
          {moreLabel} →
        </a>
      </li>
    ))}
  </ul>
</section>
<style>
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  }
  .featured {
    grid-column: span 2;
    border: 2px solid var(--vv-color-primary);
  }
  @media (max-width: 40rem) {
    .featured {
      grid-column: auto;
    }
  }
  img {
    width: 100%;
    height: auto;
    border-radius: calc(var(--vv-radius) / 2);
  }
  h3 {
    font-size: 1.4rem;
    margin: 0.25rem 0 0.5rem;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
  }
  .tags li {
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid var(--vv-color-border);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
  }
</style>
