---
import { tagFilterScript, type ProjectsView } from '@vvitrine/sections';
type Props = ProjectsView & { sectionId: string };
const { title, items, moreLabel, featuredLabel, filter, sectionId } = Astro.props;
---

<section id={sectionId} aria-labelledby={`${sectionId}-title`}>
  <h2 id={`${sectionId}-title`}>{title}</h2>
  {filter && (
    <nav class="filter" aria-label={filter.label}>
      <ul>
        {filter.links.map((link) => (
          <li>
            <a href={link.href} data-tag={link.slug} aria-current={link.current ? 'page' : undefined}>
              {link.name}
              <span class="count" aria-hidden="true">
                {link.count}
              </span>
            </a>
          </li>
        ))}
      </ul>
      {filter.instant && (
        <>
          <p
            class="visually-hidden"
            role="status"
            data-tag-status
            data-one={filter.status.one}
            data-other={filter.status.other}
          />
          {/* Progressive enhancement: filters in place; without JavaScript the links open the tag pages. */}
          <script is:inline set:html={tagFilterScript} />
        </>
      )}
    </nav>
  )}
  <ul class="grid">
    {items.map((p) => (
      <li class={`card${p.featured ? ' featured' : ''}`} data-tags={p.keywordSlugs.join(' ')}>
        {p.image && (
          <img
            src={p.image.src}
            srcset={p.image.srcset}
            sizes={p.image.srcset ? `(min-width: 64rem) ${p.featured ? 64 : 32}rem, 100vw` : undefined}
            alt={p.image.alt}
            width={p.image.width}
            height={p.image.height}
            loading="lazy"
            decoding="async"
          />
        )}
        {p.featured && <p class="pick">{featuredLabel}</p>}
        <h3>
          <a href={p.href}>{p.name}</a>
        </h3>
        {p.description && <p>{p.description}</p>}
        {p.keywords.length > 0 && (
          <ul class="tags">
            {p.keywords.map((k) => (
              <li>{k}</li>
            ))}
          </ul>
        )}
        {/* A visual hint only: the title link already covers the whole card (one link per card). */}
        <span class="more" aria-hidden="true">
          {moreLabel} →
        </span>
      </li>
    ))}
  </ul>
</section>
<style>
  .filter ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .filter a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.25rem 1rem;
    border: 2px solid var(--vv-color-primary);
    border-radius: 999px;
    color: var(--vv-color-text);
    font-weight: 700;
    text-decoration: none;
  }
  .filter a:hover {
    text-decoration: underline;
  }
  .filter a[aria-current='page'] {
    background: var(--vv-color-primary);
    color: var(--vv-color-on-primary);
  }
  .count {
    font-size: 0.8rem;
    font-weight: 600;
  }
  [data-tags][hidden] {
    display: none;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  }
  .card {
    /* The title link is stretched over the card, so the whole card is one link (design review D4). */
    position: relative;
  }
  .card:hover {
    outline: 2px solid var(--vv-color-accent);
  }
  .card:focus-within {
    outline: 3px solid var(--vv-color-accent);
    outline-offset: 3px;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .pick {
    display: inline-block;
    margin: 0.5rem 0 0;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--vv-color-primary);
    color: var(--vv-color-on-primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .more {
    color: var(--vv-color-primary);
    font-weight: 600;
  }
  .card:hover .more {
    text-decoration: underline;
  }
  .featured {
    grid-column: span 2;
    border: 2px solid var(--vv-color-primary);
  }
  @media (max-width: 40rem) {
    .featured {
      grid-column: auto;
    }
  }
  img {
    width: 100%;
    height: auto;
    border-radius: calc(var(--vv-radius) / 2);
  }
  h3 {
    font-size: 1.4rem;
    margin: 0.25rem 0 0.5rem;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
  }
  .tags li {
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid var(--vv-color-border);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
  }
</style>
