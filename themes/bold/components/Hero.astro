---
import type { HeroView } from '@vvitrine/sections';
type Props = HeroView & { sectionId: string };
const { name, label, summary, location, availability, photo, initials, actions, links, sectionId } = Astro.props;
---

<header id={sectionId} class="hero">
  <div class="avatar">
    {photo ? (
      <img
        src={photo.src}
        srcset={photo.srcset}
        sizes={photo.srcset ? '(min-width: 48rem) 11rem, 7rem' : undefined}
        alt={photo.alt}
        width="176"
        height="176"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <span class="initials" aria-hidden="true">
        {initials}
      </span>
    )}
  </div>
  <div class="identity">
    {label && <p class="label">{label}</p>}
    <h1>{name}</h1>
    {summary && <p class="summary">{summary}</p>}
    <p class="meta">
      {location && <span class="muted">{location}</span>}
      {availability && <span class="badge">{availability}</span>}
    </p>
    {(actions.length > 0 || links.length > 0) && (
      <ul class="links">
        {actions.map((a, i) => (
          <li>
            <a class:list={['button', i === 0 ? 'primary' : 'secondary']} href={a.href} download={a.download}>
              {a.label}
            </a>
          </li>
        ))}
        {links.map((l) => (
          <li>
            <a href={l.url} rel="me noopener">
              {l.label} →
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</header>
<style>
  .hero {
    display: grid;
    gap: 1.5rem 3rem;
    align-items: center;
    padding: 3rem 0 1rem;
  }
  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 11rem 1fr;
    }
  }
  .avatar img,
  .initials {
    display: grid;
    place-items: center;
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    box-shadow:
      0 0 0 4px var(--vv-color-background),
      0 0 0 7px var(--vv-color-accent);
  }
  @media (min-width: 48rem) {
    .avatar img,
    .initials {
      width: 11rem;
      height: 11rem;
    }
  }
  .avatar img {
    object-fit: cover;
  }
  .initials {
    background: linear-gradient(135deg, var(--vv-color-primary), var(--vv-color-accent));
    color: var(--vv-color-on-primary);
    font: 900 clamp(2.5rem, 6vw, 3.5rem) / 1 var(--vv-font-heading);
  }
  .label {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 700;
    color: var(--vv-color-muted);
    margin: 0;
    font-size: 0.9rem;
  }
  h1 {
    font-size: clamp(2.6rem, 9vw, 5.25rem);
    font-weight: 900;
    margin: 0.4rem 0 1.25rem;
    color: var(--vv-color-primary);
    letter-spacing: -0.02em;
  }
  @supports (background-clip: text) {
    h1 {
      background: linear-gradient(90deg, var(--vv-color-primary), var(--vv-color-accent));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }
  .summary {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    max-width: 42rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .badge {
    background: var(--vv-color-surface);
    border: 2px solid var(--vv-color-accent);
    border-radius: 999px;
    padding: 0.25rem 0.85rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }
  .links li {
    /* Long words must wrap instead of widening the page. */
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .button {
    display: inline-block;
    padding: 0.6rem 1.3rem;
    border: 2px solid var(--vv-color-primary);
    /* A full pill on one line, a rounded rectangle if the label wraps. */
    border-radius: 1.5rem;
    text-decoration: none;
  }
  .primary {
    background: var(--vv-color-primary);
    color: var(--vv-color-on-primary);
  }
  .button:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
</style>
