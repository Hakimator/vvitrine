---
/** Draws every `entries` view (experience, education, volunteering, awards...) as cards. */
import type { EntriesView } from '@vvitrine/core';
type Props = EntriesView & { sectionId: string };
const { title, items, sectionId } = Astro.props;
---

<section id={sectionId} aria-labelledby={`${sectionId}-title`}>
  <h2 id={`${sectionId}-title`}>{title}</h2>
  <ol class="grid">
    {items.map((item) => (
      <li class="card">
        {item.meta.length > 0 && <p class="muted period">{item.meta.join(' · ')}</p>}
        <h3>{item.url && !item.subtitle ? <a href={item.url}>{item.title}</a> : item.title}</h3>
        {item.subtitle && <p class="sub">{item.url ? <a href={item.url}>{item.subtitle}</a> : item.subtitle}</p>}
        {item.summary && <p>{item.summary}</p>}
        {item.notes.length > 0 && (
          <ul>
            {item.notes.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</section>
<style>
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  }
  .card {
    border-top: 4px solid var(--vv-color-primary);
  }
  .period {
    font-size: 0.85rem;
    margin: 0;
  }
  h3 {
    margin: 0.3rem 0 0.1rem;
    font-size: 1.25rem;
  }
  .sub {
    font-weight: 700;
    color: var(--vv-color-accent);
    margin: 0 0 0.5rem;
  }
  ul {
    padding-left: 1.1rem;
    margin: 0.5rem 0 0;
  }
</style>
