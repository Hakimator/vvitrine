---
/** Renders both `work` and `education` views as cards. */
import type { EducationView, WorkView } from '@vvitrine/sections';
type Props = (WorkView | EducationView) & { sectionId: string };
const { title, items, sectionId } = Astro.props;
type Item = Record<string, any>;
const heading = (i: Item) => ('position' in i ? i.position : i.institution);
const sub = (i: Item) => ('position' in i ? i.organization : i.degree);
const notes = (i: Item): readonly string[] => i.highlights ?? i.courses ?? [];
---

<section id={sectionId} aria-labelledby={`${sectionId}-title`}>
  <h2 id={`${sectionId}-title`}>{title}</h2>
  <ol class="grid">
    {items.map((item) => (
      <li class="card">
        <p class="muted period">{item.period}</p>
        <h3>{heading(item)}</h3>
        {sub(item) && <p class="sub">{item.url ? <a href={item.url}>{sub(item)}</a> : sub(item)}</p>}
        {'summary' in item && item.summary && <p>{item.summary}</p>}
        {notes(item).length > 0 && (
          <ul>
            {notes(item).map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</section>
<style>
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  }
  .card {
    border-top: 4px solid var(--vv-color-primary);
  }
  .period {
    font-size: 0.85rem;
    margin: 0;
  }
  h3 {
    margin: 0.3rem 0 0.1rem;
    font-size: 1.25rem;
  }
  .sub {
    font-weight: 700;
    color: var(--vv-color-accent);
    margin: 0 0 0.5rem;
  }
  ul {
    padding-left: 1.1rem;
    margin: 0.5rem 0 0;
  }
</style>
