---
import type { Navigation, Translate } from '@vvitrine/core';
interface Props {
  lang: string;
  title: string;
  path: string;
  t: Translate;
  url: (path: string, locale?: string) => string;
  alternates: readonly { locale: string; href: string }[];
  locales: readonly string[];
  siteName: string;
  nav: Navigation;
  /** Set on pages where no section renders the <h1> (pages without a hero). */
  heading?: string | undefined;
}
const { lang, title, t, alternates, siteName, nav, heading } = Astro.props;
// The switcher lists the other languages only: the current one needs no link.
const otherLocales = alternates.filter((a) => a.locale !== lang);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      {t('common.skipToContent')}
    </a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={nav.home}>
          {siteName}
        </a>
        {nav.items.length > 0 && (
          <nav class="nav-inline" aria-label={t('common.mainNav')}>
            <ul>
              {nav.items.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {otherLocales.length > 0 && (
          <nav class="locales" aria-label={t('common.language')}>
            <ul>
              {otherLocales.map((a) => (
                <li>
                  <a href={a.href} hreflang={a.locale} lang={a.locale}>
                    {t(`locale.${a.locale}`)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {nav.items.length > 0 && (
          <details class="nav-menu">
            <summary>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
                <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
              </svg>
              <span class="visually-hidden">{t('common.menu')}</span>
            </summary>
            <nav aria-label={t('common.mainNav')}>
              <ul>
                {nav.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )}
      </div>
    </header>
    <main id="main">
      {heading && <h1 class="page-heading">{heading}</h1>}
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {year} {siteName}
      </p>
      {nav.footer.length > 0 && (
        <nav aria-label={t('theme.footerNav')}>
          <ul>
            {nav.footer.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <p class="built-with">{t('theme.builtWith', { name: 'VVitrine' })}</p>
    </footer>
    <slot name="body-end" />
  </body>
</html>
<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    color-scheme: light dark;
  }
  body {
    margin: 0;
    background: var(--vv-color-background);
    color: var(--vv-color-text);
    font: 1.0625rem/1.6 var(--vv-font-body);
    /* A word longer than its line (a French heading, a URL) breaks instead of widening the page. */
    overflow-wrap: break-word;
  }
  h1,
  h2,
  h3 {
    hyphens: auto;
  }
  main,
  .site-footer {
    max-width: var(--vv-content-width);
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  main {
    padding-block: 1rem 4rem;
  }
  h1,
  h2,
  h3 {
    font-family: var(--vv-font-heading);
    line-height: 1.15;
  }
  h2 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 800;
    margin: 4rem 0 1.25rem;
  }
  a {
    color: var(--vv-color-primary);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }
  a:focus-visible {
    outline: 3px solid var(--vv-color-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    background: var(--vv-color-primary);
    color: var(--vv-color-on-primary);
    padding: 0.6rem 1rem;
    border-radius: var(--vv-radius);
  }
  .skip:focus {
    left: 1rem;
  }
  /* Header: the name, one link per section (inline on wide screens, a <details> menu on small ones)
     and the language switcher. No JavaScript. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--vv-color-background);
    border-bottom: 3px solid var(--vv-color-primary);
    font-family: var(--vv-font-heading);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    max-width: var(--vv-content-width);
    min-height: 3.75rem;
    margin: 0 auto;
    padding: 0.5rem 1.25rem;
  }
  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .brand {
    min-width: 0;
    overflow-wrap: anywhere;
    margin-right: auto;
    font-weight: 900;
    font-size: 1.1rem;
    color: var(--vv-color-text);
    text-decoration: none;
  }
  .nav-inline {
    display: none;
  }
  /* Room for about eight links in French at 64rem; more links wrap to a second line, aligned to the right. */
  .nav-inline ul {
    justify-content: flex-end;
    gap: 0.25rem 1rem;
    font-size: 0.95rem;
  }
  .nav-inline a {
    color: var(--vv-color-text);
    text-decoration: none;
  }
  .nav-inline a:hover {
    color: var(--vv-color-primary);
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }
  .locales a {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 2px solid var(--vv-color-primary);
    text-decoration: none;
    font-size: 0.85rem;
  }
  .locales a:hover {
    background: var(--vv-color-primary);
    color: var(--vv-color-on-primary);
  }
  .nav-menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--vv-color-primary);
    border-radius: 50%;
    color: var(--vv-color-primary);
    cursor: pointer;
    list-style: none;
  }
  .nav-menu summary::-webkit-details-marker {
    display: none;
  }
  .nav-menu summary:focus-visible {
    outline: 3px solid var(--vv-color-accent);
    outline-offset: 3px;
  }
  .nav-menu[open] summary {
    background: var(--vv-color-primary);
    color: var(--vv-color-on-primary);
  }
  .nav-menu nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--vv-color-surface);
    border-bottom: 3px solid var(--vv-color-primary);
  }
  .nav-menu ul {
    flex-direction: column;
    max-width: var(--vv-content-width);
    margin: 0 auto;
    padding: 0.5rem 1.25rem;
  }
  .nav-menu a {
    display: block;
    padding: 0.55rem 0;
    font-size: 1.15rem;
  }
  @media (min-width: 64rem) {
    .brand {
      white-space: nowrap;
    }
    .nav-inline {
      display: block;
    }
    .nav-menu {
      display: none;
    }
  }
  .page-heading {
    margin: 2.5rem 0 0;
    font: 900 clamp(2.4rem, 8vw, 4rem) / 1.05 var(--vv-font-heading);
    letter-spacing: -0.02em;
  }
  /* Sections stay visible below the sticky header when reached through a link. */
  main,
  main [id] {
    scroll-margin-top: 5rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .site-footer {
    color: var(--vv-color-muted);
    font-size: 0.85rem;
    padding-block: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer a {
    /* At least 24 px high: an easy target (WCAG 2.5.8). */
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--vv-color-text);
  }
  .site-footer .built-with {
    margin-left: auto;
  }
  .muted {
    color: var(--vv-color-muted);
  }
  .card {
    background: var(--vv-color-surface);
    border-radius: var(--vv-radius);
    padding: 1.5rem;
  }
</style>
