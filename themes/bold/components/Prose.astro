---
/**
 * A Markdown write-up already converted to HTML (project pages, articles). The HTML is injected, so the styles are
 * global inside .prose.
 */
interface Props {
  html: string;
}
const { html } = Astro.props;
---

<div class="prose" set:html={html} />
<style>
  .prose :global(h2) {
    margin-top: 2rem;
  }
  .prose :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.15rem;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--vv-radius);
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border-radius: var(--vv-radius);
    background: var(--vv-color-surface);
    border: 1px solid var(--vv-color-border);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .prose :global(code) {
    font-family: ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
  }
  .prose :global(:not(pre) > code) {
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    background: var(--vv-color-surface);
    font-size: 0.9em;
  }
  .prose :global(blockquote) {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--vv-color-accent);
    color: var(--vv-color-muted);
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--vv-color-border);
    text-align: left;
  }
</style>
