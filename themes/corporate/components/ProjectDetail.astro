---
import type { ProjectDetailView } from '@vvitrine/sections';
import Prose from './Prose.astro';
type Props = ProjectDetailView & { sectionId: string };
const { name, description, period, keywords, highlights, roles, url, repository, image, body, labels, backHref } =
  Astro.props;
---

<article class="detail">
  <p>
    <a href={backHref}>← {labels.back}</a>
  </p>
  <h1>{name}</h1>
  {period && <p class="muted">{period}</p>}
  {image && (
    <img
      src={image.src}
      srcset={image.srcset}
      sizes={image.srcset ? '(min-width: 64rem) 64rem, 100vw' : undefined}
      alt={image.alt}
      width={image.width}
      height={image.height}
      fetchpriority="high"
      decoding="async"
    />
  )}
  {description && <p class="lead">{description}</p>}
  {/* The Markdown write-up, already converted to HTML by the projects section. */}
  {body && <Prose html={body} />}
  {roles.length > 0 && (
    <>
      <h2>{labels.role}</h2>
      <p>{roles.join(', ')}</p>
    </>
  )}
  {highlights.length > 0 && (
    <ul>
      {highlights.map((h) => (
        <li>{h}</li>
      ))}
    </ul>
  )}
  {keywords.length > 0 && (
    <>
      <h2>{labels.stack}</h2>
      <p>{keywords.join(' · ')}</p>
    </>
  )}
  {(url || repository) && (
    <p class="actions">
      {url && <a href={url}>{labels.demo}</a>}
      {repository && <a href={repository}>{labels.code}</a>}
    </p>
  )}
</article>
<style>
  h1 {
    margin: 0.5rem 0 0;
  }
  .lead {
    font-size: 1.15rem;
  }
  img {
    width: 100%;
    height: auto;
    border-radius: var(--vv-radius);
    margin: 1rem 0;
  }
  .actions {
    display: flex;
    gap: 1.5rem;
    font-family: var(--vv-font-heading);
  }
</style>
