---
/** Draws every `tags` view (skills, interests...). */
import type { TagsView } from '@vvitrine/core';
type Props = TagsView & { sectionId: string };
const { title, groups, sectionId } = Astro.props;
---

<section id={sectionId} aria-labelledby={`${sectionId}-title`}>
  <h2 id={`${sectionId}-title`}>{title}</h2>
  <dl>
    {groups.map((g) => (
      <>
        <dt>
          {g.name}
          {g.level && <span class="muted"> ({g.level})</span>}
        </dt>
        <dd>{g.keywords.join(' · ')}</dd>
      </>
    ))}
  </dl>
</section>
<style>
  dl {
    display: grid;
    grid-template-columns: minmax(8rem, max-content) 1fr;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }
  dt {
    font-weight: 700;
    font-family: var(--vv-font-heading);
  }
  dd {
    margin: 0;
  }
  @media (max-width: 30rem) {
    dl {
      grid-template-columns: 1fr;
    }
    dd {
      margin-bottom: 0.5rem;
    }
  }
</style>
