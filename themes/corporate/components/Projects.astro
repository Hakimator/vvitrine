---
import type { ProjectsView } from '@vvitrine/sections';
type Props = ProjectsView & { sectionId: string };
const { title, items, moreLabel, featuredLabel, sectionId } = Astro.props;
---

<section id={sectionId} aria-labelledby={`${sectionId}-title`}>
  <h2 id={`${sectionId}-title`}>{title}</h2>
  <ul class="projects">
    {items.map((p) => (
      <li>
        <article>
          {p.image && (
            <img
              src={p.image.src}
              srcset={p.image.srcset}
              sizes={p.image.srcset ? '(min-width: 48rem) 24rem, 100vw' : undefined}
              alt={p.image.alt}
              width={p.image.width}
              height={p.image.height}
              loading="lazy"
              decoding="async"
            />
          )}
          <h3>
            <a href={p.href}>{p.name}</a>
          </h3>
          {(p.period || p.featured) && (
            <p class="muted meta">
              {p.period}
              {p.period && p.featured && ' · '}
              {p.featured && <span class="pick">{featuredLabel}</span>}
            </p>
          )}
          {p.description && <p>{p.description}</p>}
          {p.keywords.length > 0 && <p class="muted tags">{p.keywords.join(' · ')}</p>}
          {/* A visual hint only: the title link already covers the whole card (one link per card). */}
          <span class="more" aria-hidden="true">
            {moreLabel} →
          </span>
        </article>
      </li>
    ))}
  </ul>
</section>
<style>
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  article {
    /* The title link is stretched over the card, so the whole card is one link (design review D4). */
    position: relative;
    border: 1px solid var(--vv-color-border);
    border-radius: var(--vv-radius);
    padding: 1rem 1.25rem;
    height: 100%;
    background: var(--vv-color-surface);
  }
  img {
    width: 100%;
    height: auto;
    border-radius: var(--vv-radius);
  }
  article:hover {
    border-color: var(--vv-color-primary);
  }
  article:focus-within {
    outline: 3px solid var(--vv-color-accent);
    outline-offset: 2px;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .meta,
  .tags {
    font-size: 0.9rem;
    margin: 0.2rem 0;
  }
  .pick {
    color: var(--vv-color-accent);
    font-weight: 600;
  }
  .more {
    display: inline-block;
    margin-top: 0.25rem;
    color: var(--vv-color-primary);
    font-family: var(--vv-font-heading);
    font-size: 0.9rem;
  }
  article:hover .more {
    text-decoration: underline;
  }
</style>
