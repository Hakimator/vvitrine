---
/** Draws every `entries` view (experience, education, volunteering, awards...) as a timeline. */
import type { EntriesView, EntryItem } from '@vvitrine/core';
type Props = EntriesView & { sectionId: string };
const { title, items, sectionId } = Astro.props;
const heading = (i: EntryItem) => (i.subtitle ? `${i.title} · ${i.subtitle}` : i.title);
---

<section id={sectionId} aria-labelledby={`${sectionId}-title`}>
  <h2 id={`${sectionId}-title`}>{title}</h2>
  <ol class="timeline">
    {items.map((item) => (
      <li>
        <h3>{item.url ? <a href={item.url}>{heading(item)}</a> : heading(item)}</h3>
        {item.meta.length > 0 && <p class="muted meta">{item.meta.join(' · ')}</p>}
        {item.summary && <p>{item.summary}</p>}
        {item.notes.length > 0 && (
          <ul>
            {item.notes.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</section>
<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .timeline > li {
    margin-bottom: 1.4rem;
  }
  h3 {
    font-size: 1.05rem;
    margin: 0;
  }
  .meta {
    margin: 0.1rem 0 0.3rem;
    font-size: 0.95rem;
  }
  ul {
    margin: 0.3rem 0 0;
    padding-left: 1.2rem;
  }
</style>
