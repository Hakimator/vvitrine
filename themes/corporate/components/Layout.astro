---
import type { Navigation, Translate } from '@vvitrine/core';
interface Props {
  lang: string;
  title: string;
  path: string;
  t: Translate;
  url: (path: string, locale?: string) => string;
  alternates: readonly { locale: string; href: string }[];
  locales: readonly string[];
  siteName: string;
  nav: Navigation;
  /** Set on pages where no section renders the <h1> (pages without a hero). */
  heading?: string | undefined;
  /** Set when the theme offers the light/dark switch. */
  colorScheme?: { label: string } | undefined;
}
const { lang, title, t, alternates, siteName, nav, heading, colorScheme } = Astro.props;
// The switcher lists the other languages only: the current one needs no link.
const otherLocales = alternates.filter((a) => a.locale !== lang);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      {t('common.skipToContent')}
    </a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={nav.home}>
          {siteName}
        </a>
        {nav.items.length > 0 && (
          <nav class="nav-inline" aria-label={t('common.mainNav')}>
            <ul>
              {nav.items.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {otherLocales.length > 0 && (
          <nav class="locales" aria-label={t('common.language')}>
            <ul>
              {otherLocales.map((a) => (
                <li>
                  <a href={a.href} hreflang={a.locale} lang={a.locale}>
                    {t(`locale.${a.locale}`)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {colorScheme && (
          // Shown by the colour scheme script: without JavaScript the system preference applies.
          <button type="button" class="scheme-toggle" data-color-scheme-toggle aria-pressed="false" hidden>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
              <path
                d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"
              />
            </svg>
            <span class="visually-hidden">{colorScheme.label}</span>
          </button>
        )}
        {nav.items.length > 0 && (
          <details class="nav-menu">
            <summary>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
                <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span class="visually-hidden">{t('common.menu')}</span>
            </summary>
            <nav aria-label={t('common.mainNav')}>
              <ul>
                {nav.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )}
      </div>
    </header>
    <main id="main">
      {heading && <h1 class="page-heading">{heading}</h1>}
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {year} {siteName}
      </p>
      {nav.footer.length > 0 && (
        <nav aria-label={t('theme.footerNav')}>
          <ul>
            {nav.footer.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <p class="built-with">{t('theme.builtWith', { name: 'VVitrine' })}</p>
    </footer>
    <slot name="body-end" />
  </body>
</html>
<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    color-scheme: light dark;
  }
  body {
    margin: 0;
    background: var(--vv-color-background);
    color: var(--vv-color-text);
    font: 1.0625rem/1.65 var(--vv-font-body);
    /* A word longer than its line (a French heading, a URL) breaks instead of widening the page. */
    overflow-wrap: break-word;
  }
  h1,
  h2,
  h3 {
    hyphens: auto;
  }
  main,
  .site-footer {
    max-width: var(--vv-content-width);
    margin: 0 auto;
    padding: 0 1rem;
  }
  main {
    padding-block: 2.5rem 3rem;
  }
  h1,
  h2,
  h3 {
    font-family: var(--vv-font-heading);
    color: var(--vv-color-primary);
    line-height: 1.25;
  }
  h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--vv-color-border);
    padding-bottom: 0.4rem;
    margin: 2.75rem 0 1rem;
  }
  a {
    color: var(--vv-color-primary);
    text-underline-offset: 0.15em;
  }
  a:focus-visible {
    outline: 3px solid var(--vv-color-accent);
    outline-offset: 2px;
  }
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    background: var(--vv-color-primary);
    color: var(--vv-color-on-primary);
    padding: 0.5rem 1rem;
  }
  .skip:focus {
    left: 1rem;
  }
  /* Header: the name, one link per section (inline on wide screens, a <details> menu on small ones)
     and the language switcher. No JavaScript. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--vv-color-background);
    border-bottom: 1px solid var(--vv-color-border);
    font-family: var(--vv-font-heading);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem clamp(0.6rem, 2.5vw, 1.5rem);
    max-width: var(--vv-content-width);
    min-height: 3.5rem;
    margin: 0 auto;
    padding: 0.5rem 1rem;
  }
  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .brand {
    min-width: 0;
    /* Break between words; inside a word only when a single word cannot fit. */
    overflow-wrap: break-word;
    font-weight: 700;
    color: var(--vv-color-text);
    text-decoration: none;
    margin-right: auto;
  }
  .nav-inline {
    display: none;
  }
  /* Links that do not fit on one line wrap to a second one, aligned to the right. */
  .nav-inline ul {
    justify-content: flex-end;
    gap: 0.25rem 1.25rem;
  }
  .nav-inline a {
    color: var(--vv-color-text);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .nav-inline a:hover {
    color: var(--vv-color-primary);
    text-decoration: underline;
  }
  .locales ul {
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .locales a {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--vv-color-border);
    border-radius: 999px;
    text-decoration: none;
  }
  .locales a:hover {
    border-color: var(--vv-color-primary);
  }
  .scheme-toggle {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--vv-color-border);
    border-radius: 50%;
    background: none;
    color: var(--vv-color-text);
    cursor: pointer;
  }
  .scheme-toggle[hidden] {
    display: none;
  }
  .scheme-toggle[aria-pressed='true'] {
    background: var(--vv-color-surface);
  }
  .scheme-toggle:focus-visible {
    outline: 3px solid var(--vv-color-accent);
    outline-offset: 2px;
  }
  .nav-menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--vv-color-border);
    border-radius: 50%;
    color: var(--vv-color-text);
    cursor: pointer;
    list-style: none;
  }
  .nav-menu summary::-webkit-details-marker {
    display: none;
  }
  .nav-menu summary:focus-visible {
    outline: 3px solid var(--vv-color-accent);
    outline-offset: 2px;
  }
  .nav-menu[open] summary {
    background: var(--vv-color-surface);
  }
  .nav-menu nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--vv-color-surface);
    border-bottom: 1px solid var(--vv-color-border);
  }
  .nav-menu ul {
    flex-direction: column;
    max-width: var(--vv-content-width);
    margin: 0 auto;
    padding: 0.5rem 1rem;
  }
  .nav-menu a {
    display: block;
    padding: 0.5rem 0;
    font-size: 1.05rem;
  }
  @media (min-width: 64rem) {
    /* The bar is wider than the text column so that every section link fits on one line. */
    .bar {
      max-width: calc(var(--vv-content-width) + 16rem);
    }
    .brand {
      white-space: nowrap;
    }
    .nav-inline {
      display: block;
    }
    .nav-menu {
      display: none;
    }
  }
  .page-heading {
    margin: 2.5rem 0 0;
    color: var(--vv-color-primary);
    font: 700 clamp(1.9rem, 5vw, 2.4rem) / 1.2 var(--vv-font-heading);
  }
  /* Sections stay visible below the sticky header when reached through a link. */
  main,
  main [id] {
    scroll-margin-top: 4.5rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .site-footer {
    border-top: 1px solid var(--vv-color-border);
    color: var(--vv-color-muted);
    font-size: 0.85rem;
    padding-block: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer a {
    /* At least 24 px high: an easy target (WCAG 2.5.8). */
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--vv-color-text);
  }
  .site-footer .built-with {
    margin-left: auto;
  }
  .muted {
    color: var(--vv-color-muted);
  }

  /* Paper: A4, no navigation, no buttons, light colours (the tokens' dark variant is for screens only). */
  @media print {
    @page {
      size: A4;
      margin: 15mm;
    }
    html {
      font-size: 10pt;
    }
    body {
      background: #fff;
    }
    /* !important: print must win over each component's own display rules. */
    .skip,
    .site-header,
    .site-footer,
    .vv-consent,
    form,
    li:has(> .button) {
      display: none !important;
    }
    main {
      padding-block: 0;
    }
    section,
    article,
    li {
      break-inside: avoid;
    }
    h2,
    h3 {
      break-after: avoid;
    }
    a {
      color: inherit;
    }
    /* Profile links: show where they lead, since paper cannot be clicked. */
    a[rel~='me']::after {
      content: ' (' attr(href) ')';
      font-size: 0.85em;
    }
  }
</style>
