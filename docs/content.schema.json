{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VVitrine content file",
  "description": "One content file (content/<name>.<locale>.yaml). Generated from the schemas by `pnpm reference`.",
  "type": "object",
  "properties": {
    "basics": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "image": {
          "description": "Your photo in public/, e.g. /photo.jpg; initials are shown without it.",
          "type": "string",
          "x-editor": "image"
        },
        "email": {
          "description": "Never written plainly in the pages (protected from spam harvesters).",
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "x-editor": "long-text"
        },
        "location": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "countryCode": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          }
        },
        "profiles": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "network": {
                "type": "string",
                "minLength": 1
              },
              "username": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "network"
            ]
          }
        },
        "x-vvitrine": {
          "type": "object",
          "properties": {
            "availability": {
              "description": "Shown under your name, e.g. \"Looking for an internship\".",
              "type": "string"
            }
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "awards": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "awarder": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "x-editor": "long-text"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "posts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "summary": {
            "type": "string",
            "x-editor": "long-text"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "draft": {
            "default": false,
            "description": "Keep the article out of the site.",
            "type": "boolean"
          },
          "x-vvitrine": {
            "default": {},
            "type": "object",
            "properties": {
              "slug": {
                "description": "Address of the article, /blog/<slug>; default: the file name.",
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "body": {
                "description": "The article in Markdown (the text of the Markdown file).",
                "type": "string",
                "x-editor": "markdown"
              }
            }
          }
        },
        "required": [
          "title",
          "date"
        ]
      }
    },
    "certificates": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "issuer": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "education": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "area": {
            "type": "string"
          },
          "studyType": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "score": {
            "type": "string"
          },
          "courses": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "institution"
        ]
      }
    },
    "interests": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "languages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "fluency": {
            "type": "string"
          }
        },
        "required": [
          "language"
        ]
      }
    },
    "projects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "x-editor": "long-text"
          },
          "highlights": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "x-vvitrine": {
            "default": {
              "featured": false
            },
            "type": "object",
            "properties": {
              "slug": {
                "description": "Address of the project page, /projects/<slug>; default: made from the name.",
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "repository": {
                "description": "Source code, linked from the project page.",
                "type": "string",
                "format": "uri"
              },
              "featured": {
                "default": false,
                "description": "Shown first, with a \"Featured\" label.",
                "type": "boolean"
              },
              "image": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "x-editor": "image",
                    "description": "Picture in public/, e.g. /projects/app.png."
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "What the picture shows, for people who cannot see it."
                  }
                },
                "required": [
                  "src",
                  "alt"
                ]
              },
              "body": {
                "description": "Write-up in Markdown, shown on the project page (the text of a Markdown file).",
                "type": "string",
                "x-editor": "markdown"
              }
            }
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "publications": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string"
          },
          "releaseDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "summary": {
            "type": "string",
            "x-editor": "long-text"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "references": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "x-editor": "long-text"
          },
          "x-vvitrine": {
            "type": "object",
            "properties": {
              "role": {
                "description": "Who the person is, e.g. \"Team lead at Acme\".",
                "type": "string"
              }
            }
          }
        },
        "required": [
          "name",
          "reference"
        ]
      }
    },
    "skills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string"
          },
          "keywords": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "number"
              }
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "value",
          "label"
        ]
      }
    },
    "testimonials": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1,
            "x-editor": "long-text"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "quote",
          "author"
        ]
      }
    },
    "timeline": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "summary": {
            "type": "string",
            "x-editor": "long-text"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "date"
        ]
      }
    },
    "volunteer": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "summary": {
            "type": "string",
            "x-editor": "long-text"
          },
          "highlights": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "organization"
        ]
      }
    },
    "work": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "x-editor": "date"
          },
          "summary": {
            "type": "string",
            "x-editor": "long-text"
          },
          "highlights": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "position",
          "startDate"
        ]
      }
    }
  }
}
