{
  "name": "vvitrine-monorepo",
  "private": true,
  "type": "module",
  "description": "VVitrine: an open-source, plugin-based portfolio framework. Edit site/ only.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "build:bold": "cross-env VVITRINE_CONFIG=../e2e/fixtures/bold.config.ts pnpm --filter site exec astro build --outDir dist-bold",
    "preview": "pnpm --filter site preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise packages themes site --config .dependency-cruiser.cjs",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test:coverage && pnpm build:all && pnpm e2e && pnpm e2e:dev",
    "changeset": "changeset",
    "build:base": "cross-env BASE_PATH=/demo SITE_URL=https://example.github.io pnpm --filter site exec astro build --outDir dist-base",
    "build:all": "pnpm build && pnpm build:bold && pnpm build:base",
    "e2e:dev": "node e2e/dev-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "@vvitrine/analytics": "workspace:*",
    "@vvitrine/consent": "workspace:*",
    "@vvitrine/contact": "workspace:*",
    "@vvitrine/core": "workspace:*",
    "@vvitrine/sections": "workspace:*",
    "@vvitrine/seo": "workspace:*",
    "@vvitrine/images": "workspace:*",
    "@vvitrine/source-markdown": "workspace:*",
    "@vvitrine/source-yaml": "workspace:*",
    "@vvitrine/theme-bold": "workspace:*",
    "astro": "7.4.7",
    "astro-eslint-parser": "3.2.0",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
