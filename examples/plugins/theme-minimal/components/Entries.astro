---
/** The `entries` view kind: work, education, awards... and any section that returns this shape. */
import type { EntriesView } from '@vvitrine/core';
type Props = EntriesView & { sectionId: string };
const { title, items, sectionId } = Astro.props;
---

<section id={sectionId} aria-labelledby={`${sectionId}-title`}>
  <h2 id={`${sectionId}-title`}>{title}</h2>
  {items.map((item) => (
    <article>
      <h3>
        {item.url ? <a href={item.url}>{item.title}</a> : item.title}
        {item.subtitle && <span>, {item.subtitle}</span>}
      </h3>
      {item.meta.length > 0 && <p class="meta">{item.meta.join(' · ')}</p>}
      {item.summary && <p>{item.summary}</p>}
      {item.notes.length > 0 && (
        <ul>
          {item.notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      )}
    </article>
  ))}
</section>
<style>
  h3 {
    margin-bottom: 0.25rem;
    font-size: 1.05rem;
  }
  .meta {
    margin: 0;
    color: var(--vv-color-muted);
    font-size: 0.9rem;
  }
</style>
