{
  "name": "@vvitrine/astro",
  "version": "1.0.0",
  "description": "Astro integration for VVitrine: composition root. Loads vvitrine.config.ts, injects every route, renders what the kernel returns.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./routes/page.astro": "./src/routes/page.astro",
    "./routes/file.ts": "./src/routes/file.ts",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "astro": "^7.4.0"
  },
  "dependencies": {
    "@vvitrine/core": "workspace:*",
    "@vvitrine/yaml-edit": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "astro": "7.4.7"
  }
}
